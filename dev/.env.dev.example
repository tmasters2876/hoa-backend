# Local DEV environment for the admin console. `./dev.sh up` generates .env.dev
# from the running local Supabase stack; this file only documents the shape.
HOA_ENV=dev
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<from `supabase status` — local demo key, not a secret>
OPENAI_API_KEY=<copied from ../.env so Search and embeddings work>
SECRET_KEY=local-dev-only-not-a-secret
PORT=5052
